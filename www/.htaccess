# -----------------------------------------------
# URL Rewriting (CMS front controller)
#
# There is deliberately no Basic Auth block in this file: access control,
# when a site needs it, belongs in the server's own configuration.
# -----------------------------------------------
RewriteEngine On
RewriteBase /

# A program sending its API key as a bearer token: some servers keep the
# Authorization header from PHP unless it is handed over here.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Admin routes: route through PHP, but serve real static files (css, js) directly.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin(/.*)?$ index.php [QSA,L]

# Allow direct access to real static files (css, js, images, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index.php
RewriteRule ^(.*)$ index.php [QSA,L]
